<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="drumPumpTankHose" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="3" filename="textures/pumpPolymer_vmask.dds"/>
    <File fileId="4" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="2" filename="$data/shared/default_normal.dds"/>
    <File fileId="7" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubberBlack_diffuse.png"/>
    <File fileId="6" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_normal.png"/>
    <File fileId="5" filename="$data/shared/detailLibrary/nonMetallic/rubber/rubber_specular.png"/>
    <File fileId="1" filename="$data/shared/white_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="pumpBlack" materialId="1" customShaderId="4">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
      <Glossmap fileId="3"/>
      <Custommap name="detailSpecular" fileId="5"/>
      <Custommap name="detailNormal" fileId="6"/>
      <Custommap name="detailDiffuse" fileId="7"/>
      <CustomParameter name="porosity" value="0.5"/>
      <CustomParameter name="ssrParameters" value="0.25 1 -0.19"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="drumPumpTankHose.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="tankRestHose" nodeId="6">
      <TransformGroup name="hoseLod" lodDistance="0 8 25" nodeId="7">
        <TransformGroup name="hoseLod0" nodeId="8">
          <Shape name="tankRestHose0" shapeId="1" clipDistance="100" nodeId="9" castsShadows="true" receiveShadows="true" materialIds="1"/>
        </TransformGroup>
        <TransformGroup name="hoseLod1" nodeId="10">
          <Shape name="tankRestHose1" shapeId="2" clipDistance="100" nodeId="11" castsShadows="true" receiveShadows="true" materialIds="1"/>
        </TransformGroup>
        <TransformGroup name="hoseLod2" nodeId="12">
          <Shape name="tankRestHose2" shapeId="3" clipDistance="100" nodeId="13" castsShadows="true" receiveShadows="true" materialIds="1"/>
        </TransformGroup>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
