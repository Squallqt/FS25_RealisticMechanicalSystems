            <Shape name="label60" translation="0 0.0802544 0" shapeId="4" clipDistance="50" nodeId="3" castsShadows="true" receiveShadows="true" decalLayer="1" materialIds="2"/>
        </TransformGroup>
    </Scene>
</i3D>
