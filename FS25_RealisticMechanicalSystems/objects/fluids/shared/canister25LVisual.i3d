<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="canister25LVisual" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
    <Asset>
        <Export program="GIANTS Editor 64bit" version="10.0.2"/>
    </Asset>

    <Files>
        <File fileId="1" filename="$data/shaders/decalShader.xml"/>
        <File fileId="2" filename="canister25L_normal.dds"/>
        <File fileId="3" filename="canister25L_specular.dds"/>
        <File fileId="4" filename="../products/motorexFarmerPro/large_body_diffuse.dds"/>
        <File fileId="5" filename="../products/motorexFarmerPro/large_label_diffuse.dds"/>
    </Files>

    <Materials>
        <Material name="body60" materialId="1">
            <Texture fileId="4"/>
            <Normalmap fileId="2"/>
            <Glossmap fileId="3"/>
        </Material>
        <Material name="label60" materialId="2" customShaderId="1">
            <Texture fileId="5"/>
        </Material>
