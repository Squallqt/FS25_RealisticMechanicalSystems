<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="canisterLabel" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="i3dConverter" version="1.0"/>
  </Asset>

  <Files>
    <File fileId="1" filename="canister_label.png"/>
    <File fileId="3" filename="canister_label_back.png"/>
    <File fileId="2" filename="$data/shaders/decalShader.xml"/>
  </Files>


  <Materials>
    <Material name="labelBack_mat" materialId="2" customShaderId="2">
      <Texture fileId="3"/>
    </Material>
    <Material name="labelFront_mat" materialId="1" customShaderId="2">
      <Texture fileId="1"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="canisterLabel.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="canisterLabel" nodeId="6">
      <Shape name="labelFront" shapeId="1" clipDistance="60" nodeId="7" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="1"/>
      <Shape name="labelBack" shapeId="2" clipDistance="60" nodeId="8" castsShadows="false" receiveShadows="true" decalLayer="1" materialIds="2"/>
    </TransformGroup>
  </Scene>

</i3D>
