<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="rms_fillParent">
        <GuiElement profile="rms_fillParent" id="logView">
            <BoxLayout profile="rms_logPageFlow">
                <GuiElement profile="rms_workshopBand">
                    <RoundCorner profile="rms_inspectionSurface" />
                    <BoxLayout profile="rms_logHeroContentRow">
                        <GuiElement profile="rms_logHeroIdentity">
                            <Bitmap profile="rms_workshopVehiclePicture" id="logVehicleImage" position="11.5px 0px" size="81px 68px" />
                            <Text profile="rms_workshopHeroName" id="vehicleNameValue" position="124px -2px" size="496px 36px" />
                            <Text profile="rms_workshopLabel" id="vehicleLogIdentityValue" position="124px -42px" size="496px 24px" text="$l10n_rms_log_header_title" />
                        </GuiElement>
                        <GuiElement profile="rms_logHeroMetric" id="heroMetricTemplate">
                            <RoundCorner profile="rms_workshopSurfaceSoft" />
                            <Bitmap profile="rms_logHeroMetricIcon" name="icon" />
                            <Text profile="rms_logHeroMetricLabel" name="label" />
                            <Text profile="rms_logHeroMetricValue" name="value" />
                        </GuiElement>
                    </BoxLayout>
                </GuiElement>

            <BoxLayout profile="rms_logKpiRow">
                <GuiElement profile="rms_logKpiCard" id="kpiCardTemplate">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <Bitmap profile="rms_logKpiIcon" name="icon" />
                    <Text profile="rms_logKpiLabel" name="label" />
                    <Text profile="rms_logKpiValue" name="value" />
                </GuiElement>
            </BoxLayout>

            <BoxLayout profile="rms_logMainRow">
                <GuiElement profile="rms_logHistoryCard">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -14px" size="874px 32px">
                        <RoundCorner profile="rms_workshopSectionAccent" />
                        <Text profile="rms_workshopSectionTitle" position="16px 0px" size="858px 32px" text="$l10n_rms_ws_section_history" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 0px" size="858px 1px" />
                    </GuiElement>

                    <SmoothList profile="rms_logTableList" id="logTable" position="20px -58px" size="852px 374px">
                        <ListItem profile="rms_logTableRow" name="logRowTemplate" size="852px 68px" onClick="onRowClick">
                            <RoundCorner profile="rms_logRowSurface" />
                            <Bitmap profile="rms_logTypeIcon" name="logTypeIcon" />
                            <Text profile="rms_logRowType" position="68px -6.5px" size="220px 26px" name="logType" textUpperCase="true" />
                            <Text profile="rms_logRowMeta" position="300px -7.5px" size="188px 24px" name="logDate" />
                            <Text profile="rms_logRowMeta" position="500px -7.5px" size="188px 24px" name="logHours" />
                            <Text profile="rms_logRowPrice" position="700px -7.5px" size="134px 24px" name="logPrice" />
                            <Text profile="rms_logRowDescription" position="68px -37.5px" size="766px 24px" name="logDescription" />
                        </ListItem>
                    </SmoothList>

                    <ThreePartBitmap profile="rms_listSliderBox" position="-16px -58px" size="6px 374px">
                        <Slider profile="fs25_listSlider" dataElementId="logTable" />
                    </ThreePartBitmap>

                    <Text profile="rms_logEmptyText" id="emptylogText" text="$l10n_rms_log_empty" position="20px -205px" size="852px 80px" />
                </GuiElement>

                <GuiElement profile="rms_logDetailCard">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -14px" size="507px 32px">
                        <RoundCorner profile="rms_workshopSectionAccent" />
                        <Text profile="rms_workshopSectionTitle" position="16px 0px" size="491px 32px" text="$l10n_rms_log_description" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 0px" size="491px 1px" />
                    </GuiElement>

                    <GuiElement profile="rms_workshopBlock" position="20px -58px" size="507px 64px">
                        <RoundCorner profile="rms_workshopSurfaceSoft" />
                        <Text profile="rms_logDetailIdentityLabel" position="18px -3px" size="471px 17px" text="$l10n_rms_log_type" />
                        <BoxLayout profile="rms_workshopInfoGroup" id="detailIdentityRow" position="18px -20px" size="471px 40px" elementSpacing="10px">
                            <Bitmap profile="rms_logDetailIcon" id="selectedLogIcon" />
                            <Text profile="rms_logDetailType" id="selectedLogType" size="0px 36px" />
                        </BoxLayout>
                    </GuiElement>

                    <GuiElement profile="rms_workshopBlock" position="20px -134px" size="146px 54px">
                        <RoundCorner profile="rms_workshopSurfaceSoft" />
                        <Text profile="rms_logDetailMetaLabel" position="10px -4px" size="126px 21px" text="$l10n_rms_log_date" />
                        <Text profile="rms_tileValue" id="selectedLogDate" position="10px -26px" size="126px 24px" />
                    </GuiElement>

                    <GuiElement profile="rms_workshopBlock" position="178px -134px" size="191px 54px">
                        <RoundCorner profile="rms_workshopSurfaceSoft" />
                        <Text profile="rms_logDetailMetaLabel" position="10px -4px" size="171px 21px" text="$l10n_rms_ws_label_operating_hours" />
                        <Text profile="rms_tileValue" id="selectedLogHours" position="10px -26px" size="171px 24px" />
                    </GuiElement>

                    <GuiElement profile="rms_workshopBlock" position="381px -134px" size="146px 54px">
                        <RoundCorner profile="rms_workshopSurfaceSoft" />
                        <Text profile="rms_logDetailMetaLabel" position="10px -4px" size="126px 21px" text="$l10n_rms_log_price" />
                        <RoundCorner profile="rms_workshopValuePillCentered" position="12px -25px" size="122px 24px" />
                        <Text profile="rms_logDetailPrice" id="selectedLogPrice" position="22px -24px" size="102px 26px" />
                    </GuiElement>

                    <GuiElement profile="rms_workshopBlock" position="20px -200px" size="507px 232px">
                        <RoundCorner profile="rms_workshopSurfaceSoft" />
                        <Text profile="rms_logDetailSummary" id="selectedLogSummary" position="18px -8px" size="471px 22px" />
                        <Text profile="rms_logDetailLocation" id="selectedLogLocation" position="18px -30px" size="471px 16px" />
                        <GuiElement profile="rms_workshopBlock" id="selectedLogDetailsHeader" position="18px -54px" size="471px 18px">
                            <RoundCorner profile="rms_workshopSubsectionAccent" position="3px 0px" />
                            <Text profile="rms_workshopListLabel" id="selectedLogDetailsLabel" position="12px 0px" size="459px 18px" />
                        </GuiElement>
                        <SmoothList profile="rms_workshopPackedList" id="detailPartsTable" position="18px -74px" size="471px 154px" handleFocus="false">
                            <ListItem profile="rms_logDetailPartRow" name="detailPartRowTemplate" size="471px 22px" updateChildrenState="false">
                                <Text profile="rms_workshopListBullet" position="0px 0px" size="8px 22px" text="·" />
                                <Text profile="rms_logDetailPart" position="12px 0px" size="207.5px 22px" name="detailPartLeft" />
                                <Text profile="rms_workshopListBullet" position="235.5px 0px" size="8px 22px" text="·" name="detailPartRightBullet" />
                                <Text profile="rms_logDetailPart" position="247.5px 0px" size="207.5px 22px" name="detailPartRight" />
                            </ListItem>
                        </SmoothList>
                        <SmoothList profile="rms_workshopPackedList" id="invoiceTable" position="18px -74px" size="471px 154px" handleFocus="false">
                            <ListItem profile="rms_logDetailPartRow" name="invoiceRowTemplate" size="471px 22px" updateChildrenState="false">
                                <Text profile="rms_workshopListBullet" position="0px 0px" size="8px 22px" text="·" />
                                <Text profile="rms_logDetailPart" position="12px 0px" size="335px 22px" name="invoiceLabel" />
                                <Text profile="rms_logInvoiceAmount" position="355px 0px" size="116px 22px" name="invoiceAmount" />
                            </ListItem>
                        </SmoothList>
                    </GuiElement>
                </GuiElement>
            </BoxLayout>
            </BoxLayout>
        </GuiElement>
        <GuiElement profile="rms_fillParent" id="reportView" visible="false">
            <FrameReference ref="RMS_ReportFrame" id="report" />
        </GuiElement>
    </GuiElement>
</GUI>
