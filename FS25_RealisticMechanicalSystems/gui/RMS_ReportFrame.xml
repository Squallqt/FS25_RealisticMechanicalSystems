<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="rms_fillParent">
        <BoxLayout profile="rms_workshopReportFlow">

            <!-- Inspection identity -->
            <GuiElement profile="rms_workshopBand">
                <RoundCorner profile="rms_inspectionSurface" />
                <Bitmap profile="rms_workshopVehiclePicture" id="reportVehicleImage" position="30px -10px" size="76px 64px" />
                <Text profile="rms_workshopHeroName" id="reportTitle" position="132px -12px" size="726px 34px" textMinSize="26px" textLayoutMode="scrolling" textScrollOnFocusOnly="false" />
                <Text profile="rms_workshopReportSubtitle" id="reportSubtitle" position="132px -46px" size="726px 24px" />

                <BoxLayout profile="rms_workshopReportKpiRow" position="878px -0px">
                    <GuiElement profile="rms_workshopReportKpiGroup" id="summaryFigureTemplate">
                        <Text profile="rms_workshopReportKpiLabel" name="label" />
                        <RoundCorner profile="rms_workshopValuePillCentered" position="0px -44px" size="185px 30px" />
                        <Text profile="rms_workshopReportKpiValue" name="value" position="12px -44px" size="161px 30px" />
                    </GuiElement>
                </BoxLayout>
            </GuiElement>

            <BoxLayout profile="rms_workshopReportRowMain">

                <!-- Assessment -->
                <GuiElement profile="rms_workshopReportCardAssessment">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -16px" size="417px 32px">
                        <RoundCorner profile="rms_workshopSectionAccent" />
                        <Text profile="rms_workshopSectionTitle" position="16px 0px" size="401px 32px" text="$l10n_rms_report_overall_assessment_title" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 0px" size="401px 1px" />
                    </GuiElement>
                    <BoxLayout profile="rms_workshopStack" position="20px -60px" size="417px 148px" elementSpacing="5px">
                        <GuiElement profile="rms_workshopBlock" id="assessmentRowTemplate" size="417px 46px">
                            <RoundCorner profile="rms_workshopSurfaceSoft" />
                            <Text profile="rms_workshopReportRowLabel" name="label" position="16px 0px" size="242px 46px" />
                            <RoundCorner profile="rms_workshopValuePill" name="pill" position="264px -9px" size="137px 28px" />
                            <Text profile="rms_workshopReportPillValue" name="value" position="276px 0px" size="113px 46px" />
                        </GuiElement>
                    </BoxLayout>
                    <!-- Wear causes -->
                    <GuiElement profile="rms_workshopBlock" id="wearBlock" position="20px -213px" size="417px 97px">
                        <RoundCorner profile="rms_workshopSurfaceSoft" />
                        <Text profile="rms_workshopReportRowLabel" position="16px -2px" size="242px 34px" text="$l10n_rms_report_wear_title" />
                        <RoundCorner profile="rms_workshopValuePill" position="264px -5px" size="137px 28px" />
                        <Text profile="rms_workshopReportPillValue" id="wearValue" position="276px -2px" size="113px 34px" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 58px" size="385px 1px" />
                        <BoxLayout profile="rms_workshopStack" position="16px -42px" size="385px 51px">
                            <GuiElement profile="rms_workshopBlock" id="wearCauseRowTemplate" size="385px 17px">
                                <Text profile="rms_workshopReportCauseLabel" name="label" position="0px 0px" size="248px 17px" />
                                <Text profile="rms_workshopReportCauseValue" name="value" position="248px 0px" size="125px 17px" />
                            </GuiElement>
                        </BoxLayout>
                    </GuiElement>
                </GuiElement>

                <!-- Systems -->
                <GuiElement profile="rms_workshopReportCard">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -16px" size="456px 32px">
                        <RoundCorner profile="rms_workshopSectionAccent" />
                        <Text profile="rms_workshopSectionTitle" position="16px 0px" size="440px 32px" text="$l10n_rms_report_system_condition_title" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 0px" size="440px 1px" />
                    </GuiElement>
                    <GuiElement profile="rms_workshopBlock" position="20px -60px" size="456px 20px">
                        <Text profile="rms_workshopReportColumnHeader" position="14px 0px" size="160px 20px" text="$l10n_rms_report_component_title" />
                        <Text profile="rms_workshopReportColumnHeader" position="180px 0px" size="110px 20px" text="$l10n_rms_ws_label_condition" />
                        <Text profile="rms_workshopReportColumnHeader" position="296px 0px" size="146px 20px" text="$l10n_rms_report_breakdown_risk_title" />
                    </GuiElement>
                    <BoxLayout profile="rms_workshopStack" position="20px -86px" size="456px 222px" elementSpacing="2px">
                        <GuiElement profile="rms_workshopBlock" id="systemRowTemplate" size="456px 26px">
                            <RoundCorner profile="rms_workshopSurfaceSoft" />
                            <Text profile="rms_workshopReportSystemName" name="name" position="14px 0px" size="160px 26px" />
                            <Text profile="rms_workshopReportSystemValue" name="value" position="180px 0px" size="110px 26px" />
                            <Text profile="rms_workshopReportSystemValue" name="risk" position="296px 0px" size="146px 26px" />
                        </GuiElement>
                    </BoxLayout>
                </GuiElement>

                <!-- Performance -->
                <GuiElement profile="rms_workshopReportCard">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -16px" size="456px 32px">
                        <RoundCorner profile="rms_workshopSectionAccent" />
                        <Text profile="rms_workshopSectionTitle" position="16px 0px" size="440px 32px" text="$l10n_rms_report_vehicle_specs_title" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 0px" size="440px 1px" />
                    </GuiElement>
                    <BoxLayout profile="rms_workshopStack" position="20px -60px" size="456px 250px" elementSpacing="2px">
                        <GuiElement profile="rms_workshopBlock" id="specRowTemplate" size="456px 26px">
                            <RoundCorner profile="rms_workshopSurfaceSoft" />
                            <Text profile="rms_workshopReportRowLabel" name="label" position="14px 0px" size="236px 26px" />
                            <Text profile="rms_workshopReportSpecValue" name="value" position="256px 0px" size="186px 26px" />
                        </GuiElement>
                    </BoxLayout>
                </GuiElement>
            </BoxLayout>

            <BoxLayout profile="rms_workshopReportRowNotes">

                <GuiElement profile="rms_workshopReportCardBreakdowns">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -16px" size="690px 32px">
                        <RoundCorner profile="rms_workshopSectionAccent" />
                        <Text profile="rms_workshopSectionTitle" id="breakdownsCardTitle" position="16px 0px" size="674px 32px" text="$l10n_rms_report_detected_breakdowns_title" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 0px" size="674px 1px" />
                    </GuiElement>
                    <SmoothList profile="rms_workshopTableList" id="breakdownsTable" position="20px -56px" size="674px 154px">
                        <ListItem profile="rms_workshopReportNoteRow" name="reportBreakdownsRowTemplate" size="674px 46px" updateChildrenState="false">
                            <RoundCorner profile="rms_workshopSurfaceSoft" />
                            <Bitmap profile="rms_workshopReportNoteIcon" position="14px -12.5px" name="reportBreakdownsIcon" imageSliceId="gui.contextAction_icon_repairAlert" />
                            <Text profile="rms_workshopReportNoteTitle" position="52px -3.5px" size="416px 20px" name="reportBreakdownsTitle" />
                            <Text profile="rms_workshopReportNoteTitle" position="52px 0px" size="608px 46px" textMaxNumLines="2" textLayoutMode="resize" name="reportBreakdownsEmptyTitle" visible="false" />
                            <Text profile="rms_workshopReportNoteSeverity" position="480px -3.5px" size="180px 20px" name="reportBreakdownsSeverity" />
                            <Text profile="rms_workshopReportNoteText" position="52px -23.5px" size="608px 19px" name="reportBreakdownsText" />
                        </ListItem>
                    </SmoothList>
                    <ThreePartBitmap profile="rms_listSliderBox" position="-20px -56px" size="6px 154px">
                        <Slider profile="fs25_listSlider" dataElementId="breakdownsTable" />
                    </ThreePartBitmap>
                </GuiElement>

                <GuiElement profile="rms_workshopReportCardNotes">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -16px" size="691px 32px">
                        <RoundCorner profile="rms_workshopSectionAccent" />
                        <Text profile="rms_workshopSectionTitle" position="16px 0px" size="675px 32px" text="$l10n_rms_report_recommendations_title" />
                        <RoundCorner profile="rms_workshopSectionLine" position="16px 0px" size="675px 1px" />
                    </GuiElement>
                    <SmoothList profile="rms_workshopTableList" id="recommendationsTable" position="20px -56px" size="675px 154px">
                        <ListItem profile="rms_workshopReportNoteRow" name="reportRecRowTemplate" size="675px 46px" updateChildrenState="false">
                            <RoundCorner profile="rms_workshopSurfaceSoft" />
                            <Bitmap profile="rms_workshopIcon" position="16px -11px" size="24px 24px" imageSliceId="gui.storeAttribute_info" />
                            <Text profile="rms_workshopReportNoteText" position="52px 0px" size="609px 46px" name="reportRecRow" />
                        </ListItem>
                    </SmoothList>
                    <ThreePartBitmap profile="rms_listSliderBox" position="-20px -56px" size="6px 154px">
                        <Slider profile="fs25_listSlider" dataElementId="recommendationsTable" />
                    </ThreePartBitmap>
                </GuiElement>
            </BoxLayout>
        </BoxLayout>
    </GuiElement>
</GUI>
