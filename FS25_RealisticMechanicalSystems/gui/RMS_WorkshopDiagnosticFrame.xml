<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI>
    <GuiElement profile="rms_fillParent">
        <BoxLayout profile="rms_workshopPageFlow">
            <GuiElement profile="rms_workshopBand">
                <FrameReference ref="RMS_WorkshopStatusFrame" id="statusBar" />
            </GuiElement>

            <BoxLayout profile="rms_workshopRow">

                <GuiElement profile="rms_workshopCardNarrow">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <Bitmap profile="rms_workshopVehiclePicture" id="diagnosticVehicleImage" position="20px -118px" size="272px 230px" />
                    <Text profile="rms_workshopVehicleBrand" id="diagnosticVehicleBrand" position="20px -16px" size="272px 22px" />
                    <Text profile="rms_workshopVehicleModel" id="diagnosticVehicleName" position="20px -38px" size="272px 62px" />
                    <Text profile="rms_workshopCenteredDetail" position="20px -366px" size="272px 26px" text="$l10n_rms_ws_label_last_check" />
