                    <Text profile="rms_workshopPillValue" id="diagnosticLastInspection" position="68px -396px" size="175px 30px" />

                    <BoxLayout profile="rms_workshopStack" position="20px -450px" size="272px 96px" elementSpacing="8px">
                        <GuiElement profile="rms_workshopReadingRow" id="readingRowTemplate">
                            <RoundCorner profile="rms_workshopSurfaceSoft" />
                            <Bitmap profile="rms_workshopRowIcon" name="icon" />
                            <Text profile="rms_workshopReadingRowLabel" name="label" />
                            <RoundCorner profile="rms_workshopReadingRowPill" name="pill" />
                            <Text profile="rms_workshopReadingRowValue" name="value" />
                        </GuiElement>
                    </BoxLayout>
                </GuiElement>

                <GuiElement profile="rms_workshopCardBreakdowns">
                    <RoundCorner profile="rms_workshopSurfaceStrong" />
                    <GuiElement profile="rms_workshopBlock" position="20px -16px" size="705px 32px">
