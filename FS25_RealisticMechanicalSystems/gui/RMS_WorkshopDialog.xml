<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose" onCreate="onCreate">
    <GuiElement profile="newLayer" />
    <RoundCorner profile="rms_dialogScreenBlocker" />
    <Bitmap profile="dialogFullscreenBg" id="dialogBg" />

    <GuiElement profile="rms_workshopDialogBg" id="dialogElement" with="anchorMiddleCenter">
        <ThreePartBitmap profile="fs25_dialogBgMiddle" />
        <ThreePartBitmap profile="fs25_dialogBgTop" />
        <ThreePartBitmap profile="fs25_dialogBgBottom" />

        <GuiElement profile="fs25_dialogContentContainer">
            <GuiElement profile="rms_workshopHeaderPanel">
                <Bitmap profile="fs25_menuHeaderIconBg">
                    <Bitmap profile="rms_menuHeaderIcon" />
                </Bitmap>
                <Text profile="fs25_menuHeaderTitle" text="$l10n_rms_ws_header_title" />
                <RoundCorner profile="fs25_shopMoneyBoxBg" id="moneyBoxBg" />
                <BoxLayout profile="fs25_shopMoneyBox" id="moneyBox">
                    <Text profile="fs25_shopBalance" text="$l10n_ui_balance" />
                    <Text profile="fs25_shopMoney" id="balanceElement" />
                </BoxLayout>
            </GuiElement>

            <BoxLayout profile="rms_workshopTabBox" id="tabBox">
                <Button profile="fs25_subCategorySelectorTabbedTab" id="tabs[1]" text="$l10n_rms_ws_tab_summary" onClick="onClickTab">
                    <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
                </Button>
                <Button profile="fs25_subCategorySelectorTabbedTab" id="tabs[2]" text="$l10n_rms_ws_tab_diagnostic" onClick="onClickTab">
                    <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
                </Button>
                <Button profile="fs25_subCategorySelectorTabbedTab" id="tabs[3]" text="$l10n_rms_ws_tab_interventions" onClick="onClickTab">
                    <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
                </Button>
                <Button profile="fs25_subCategorySelectorTabbedTab" id="tabs[4]" text="$l10n_rms_ws_tab_record" onClick="onClickTab">
                    <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background" />
                </Button>
            </BoxLayout>
            <ThreePartBitmap profile="rms_workshopTabSeparator" />
            <MultiTextOption profile="rms_workshopTabPaging" id="tabPaging" onClick="onTabPagingChanged" />

            <GuiElement profile="fs25_subCategorySelectorTabbedContainer">
                <FrameReference ref="RMS_WorkshopSummaryFrame" id="pages[1]" />
                <FrameReference ref="RMS_WorkshopDiagnosticFrame" id="pages[2]" />
                <FrameReference ref="RMS_WorkshopInterventionsFrame" id="pages[3]" />
                <FrameReference ref="RMS_WorkshopRecordFrame" id="pages[4]" />
            </GuiElement>
        </GuiElement>

        <BoxLayout profile="fs25_dialogButtonBox" id="buttonBox">
            <Button profile="buttonCancel" text="$l10n_rms_ws_action_cancel_service" onClick="onClickCancelService" id="cancelServiceButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonMenuPrev" text="$l10n_rms_ws_action_inspection" onClick="onClickShortcut" id="shortcuts[1]" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonMenuNext" text="$l10n_rms_ws_action_maintenance" onClick="onClickShortcut" id="shortcuts[2]" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK" inputAction="MENU_EXTRA_2" text="$l10n_rms_ws_action_repair" onClick="onClickShortcut" id="shortcuts[3]" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonOK" text="$l10n_rms_ws_action_overhaul" onClick="onClickShortcut" id="shortcuts[4]" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonActivate" text="$l10n_rms_ws_action_refill" onClick="onClickShortcut" id="shortcuts[5]" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonExtra1" text="$l10n_rms_spec_state_bodywork" onClick="onClickShortcut" id="shortcuts[6]" handleFocus="false" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonActivate" text="$l10n_rms_ws_action_choice_remap" onClick="onClickShortcut" id="shortcuts[7]" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonActivate" onClick="onClickPageAction" id="pageActionButton" />
            <Bitmap profile="fs25_dialogButtonBoxSeparator" />
            <Button profile="buttonBack" text="$l10n_button_back" onClick="onClickBack" />
        </BoxLayout>
    </GuiElement>
</GUI>
